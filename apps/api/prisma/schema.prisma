generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum FocusCategory {
  DECISION
  COMMUNICATION
  AWARENESS
  MOVEMENT
  AIM
  POSITIONING
  MENTAL
  OTHER
}

enum TrainingCycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FocusPriority {
  PRIMARY
  SECONDARY
}

enum CycleConclusion {
  IMPROVED
  UNCHANGED
  REGRESSED
  INCONCLUSIVE
}

enum WeeklyPlanStatus {
  DRAFT
  CONFIRMED
  CLOSED
}

enum RoutineBlockType {
  RANKED
  AIM_TRAINING
  VOD_REVIEW
  COACHING
  COMPETITIVE
  THEORY
  FREE
  COMMITMENT
  OTHER
}

enum RoutineBlockStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TrainingSessionStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum MatchSource {
  MANUAL
  RIOT
  IMPORT
}

enum MatchQueueType {
  COMPETITIVE
  UNRATED
  PREMIER
  SWIFTPLAY
  SPIKE_RUSH
  DEATHMATCH
  TEAM_DEATHMATCH
  CUSTOM
  OTHER
}

enum MatchResult {
  WIN
  LOSS
  DRAW
  REMAKE
  UNKNOWN
}

enum CoachFeedbackPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CoachFeedbackStatus {
  OPEN
  IN_PROGRESS
  VALIDATED
  DISMISSED
}

enum WeeklyReviewStatus {
  GENERATED
  REVIEWED
  APPLIED
}

enum AiRecommendationType {
  SESSION_SUMMARY
  WEEKLY_SUMMARY
  WEEKLY_PLAN_PROPOSAL
}

enum AiRecommendationStatus {
  GENERATED
  CONFIRMED
  APPLIED
  REJECTED
  FAILED
}

enum AuditActor {
  USER
  AI
  MCP
  SYSTEM
}

enum IntegrationProvider {
  GOOGLE_CALENDAR
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum CalendarSyncStatus {
  SYNCED
  CANCELLED
  ERROR
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  displayName      String            @db.VarChar(120)
  timezone         String            @default("America/Sao_Paulo") @db.VarChar(80)
  profile          PlayerProfile?
  focusAreas       FocusArea[]
  trainingCycles   TrainingCycle[]
  weeklyPlans      WeeklyPlan[]
  routineBlocks    RoutineBlock[]
  trainingSessions TrainingSession[]
  matches          Match[]
  matchReflections MatchReflection[]
  coachSessions    CoachSession[]
  coachFeedbacks   CoachFeedback[]
  weeklyReviews    WeeklyReview[]
  aiRecommendations AiRecommendation[]
  auditEvents       AuditEvent[]
  integrationAccounts IntegrationAccount[]
  integrationOAuthStates IntegrationOAuthState[]
  calendarEventSyncs CalendarEventSync[]
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
}

model PlayerProfile {
  userId              String    @id @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRank         String    @db.VarChar(50)
  currentRr           Int?
  peakRank            String?   @db.VarChar(50)
  valorantName        String?   @db.VarChar(64)
  valorantTag         String?   @db.VarChar(16)
  sensitivity         Decimal   @db.Decimal(6, 3)
  dpi                 Int
  primaryGoal         String    @db.Text
  weeklyRankedMin     Int       @default(10)
  weeklyRankedMax     Int       @default(14)
  defaultSessionStart DateTime? @db.Time(0)
  defaultSessionEnd   DateTime? @db.Time(0)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)
}

model FocusArea {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @db.Uuid
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String            @db.VarChar(120)
  category           FocusCategory
  observableBehavior String            @db.Text
  active             Boolean           @default(true)
  cycleFocuses       CycleFocus[]
  routineBlocks      RoutineBlock[]
  trainingSessions   TrainingSession[]
  coachFeedbacks     CoachFeedback[]
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([userId, name])
  @@index([userId, active])
}

model WeeklyPlan {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart       DateTime         @db.Date
  weekEnd         DateTime         @db.Date
  status          WeeklyPlanStatus @default(DRAFT)
  rankedTargetMin Int
  rankedTargetMax Int
  weeklyIntent    String           @db.Text
  blocks          RoutineBlock[]
  review          WeeklyReview?
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([userId, weekStart])
  @@index([userId, status])
}

model RoutineBlock {
  id                 String             @id @default(uuid()) @db.Uuid
  weeklyPlanId       String             @db.Uuid
  weeklyPlan         WeeklyPlan         @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  userId             String             @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusAreaId        String?            @db.Uuid
  focusArea          FocusArea?         @relation(fields: [focusAreaId], references: [id], onDelete: Restrict)
  type               RoutineBlockType
  status             RoutineBlockStatus @default(DRAFT)
  title              String             @db.VarChar(160)
  plannedStart       DateTime           @db.Timestamptz(3)
  plannedEnd         DateTime           @db.Timestamptz(3)
  notes              String?            @db.Text
  cancellationReason String?            @db.Text
  session            TrainingSession?
  calendarSync       CalendarEventSync?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  @@index([weeklyPlanId, plannedStart])
  @@index([userId, status])
}

model TrainingSession {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @db.Uuid
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedBlockId       String?               @unique @db.Uuid
  plannedBlock         RoutineBlock?         @relation(fields: [plannedBlockId], references: [id], onDelete: Restrict)
  focusAreaId          String?               @db.Uuid
  focusArea            FocusArea?            @relation(fields: [focusAreaId], references: [id], onDelete: Restrict)
  type                 RoutineBlockType
  startedAt            DateTime              @db.Timestamptz(3)
  endedAt              DateTime?             @db.Timestamptz(3)
  status               TrainingSessionStatus @default(IN_PROGRESS)
  pausedAt             DateTime?             @db.Timestamptz(3)
  totalPausedSeconds   Int                   @default(0)
  preEnergy            Int?
  preFocus             Int?
  overallConcentration Int?
  focusAdherence       Int?
  mainLearning         String?               @db.Text
  nextAdjustment       String?               @db.Text
  mentalState          String?               @db.Text
  cancellationReason   String?               @db.Text
  matches              Match[]
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)

  @@index([userId, status])
  @@index([userId, startedAt])
}

model Match {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String?          @db.Uuid
  session     TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  source      MatchSource      @default(MANUAL)
  riotMatchId String?          @db.VarChar(120)
  startedAt   DateTime         @db.Timestamptz(3)
  queueType   MatchQueueType
  agentName   String           @db.VarChar(80)
  mapName     String           @db.VarChar(80)
  result      MatchResult
  allyScore   Int
  enemyScore  Int
  rrChange    Int?
  kills       Int?
  deaths      Int?
  assists     Int?
  acs         Int?
  headshotPct Decimal?         @db.Decimal(5, 2)
  firstKills  Int?
  firstDeaths Int?
  notes       String?          @db.Text
  reflection  MatchReflection?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@index([userId, startedAt])
  @@index([sessionId, startedAt])
}

model MatchReflection {
  id                             String   @id @default(uuid()) @db.Uuid
  matchId                        String   @unique @db.Uuid
  match                          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId                         String   @db.Uuid
  user                           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisionClarity                Int
  callResponse                   Int
  patternReading                 Int
  freezesCount                   Int      @default(0)
  taskConflictsCount             Int      @default(0)
  delayedCallsCount              Int      @default(0)
  communicatedIntentionsCount    Int      @default(0)
  movementErrorsCount            Int      @default(0)
  ecoPositioningErrorsCount      Int      @default(0)
  unnecessaryCrosshairMovesCount Int      @default(0)
  patternsRecognizedCount        Int      @default(0)
  adaptationsAppliedCount        Int      @default(0)
  goodDecision                   String?  @db.Text
  nextCorrection                 String?  @db.Text
  createdAt                      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId, createdAt])
}

model CoachSession {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachName       String          @default("Glym") @db.VarChar(120)
  heldAt          DateTime        @db.Timestamptz(3)
  durationMinutes Int
  summary         String          @db.Text
  feedbacks       CoachFeedback[]
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  @@index([userId, heldAt])
}

model CoachFeedback {
  id              String                @id @default(uuid()) @db.Uuid
  coachSessionId  String                @db.Uuid
  coachSession    CoachSession          @relation(fields: [coachSessionId], references: [id], onDelete: Cascade)
  userId          String                @db.Uuid
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusAreaId     String?               @db.Uuid
  focusArea       FocusArea?            @relation(fields: [focusAreaId], references: [id], onDelete: Restrict)
  category        FocusCategory
  priority        CoachFeedbackPriority
  feedbackText    String                @db.Text
  evidence        String?               @db.Text
  suggestedAction String?               @db.Text
  status          CoachFeedbackStatus   @default(OPEN)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)

  @@index([coachSessionId, priority])
  @@index([userId, status])
  @@index([focusAreaId])
}

model WeeklyReview {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @db.Uuid
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyPlanId         String             @unique @db.Uuid
  weeklyPlan           WeeklyPlan         @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  plannedMinutes       Int
  completedMinutes     Int
  consciousRankedCount Int
  wins                 Int
  losses               Int
  rrDelta              Int
  selfConclusion       String?            @db.Text
  repeatedPatterns     Json
  nextWeekProposal     Json?
  status               WeeklyReviewStatus @default(GENERATED)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)

  @@index([userId, status])
  @@index([userId, createdAt])
}

model AiRecommendation {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @db.Uuid
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             AiRecommendationType
  status           AiRecommendationStatus @default(GENERATED)
  sourceType       String                 @db.VarChar(80)
  sourceId         String?                @db.Uuid
  model            String                 @db.VarChar(120)
  promptVersion    String                 @db.VarChar(40)
  structuredOutput Json
  proposedMutation Json?
  failureReason    String?                @db.Text
  decidedAt        DateTime?              @db.Timestamptz(3)
  appliedAt        DateTime?              @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([sourceType, sourceId])
}

model AuditEvent {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String?    @db.Uuid
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  actor      AuditActor
  action     String     @db.VarChar(120)
  entityType String     @db.VarChar(80)
  entityId   String?    @db.Uuid
  summary    String     @db.Text
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([actor, action])
  @@index([entityType, entityId])
}

model IntegrationAccount {
  id                    String              @id @default(uuid()) @db.Uuid
  userId                String              @db.Uuid
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              IntegrationProvider
  status                IntegrationStatus   @default(CONNECTED)
  scopes                String[]
  encryptedCredentials  String              @db.Text
  accountLabel          String?             @db.VarChar(160)
  accessTokenExpiresAt  DateTime?            @db.Timestamptz(3)
  providerMetadata      Json?
  calendarEventSyncs    CalendarEventSync[]
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([userId, provider])
  @@index([userId, status])
}

model IntegrationOAuthState {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   IntegrationProvider
  stateHash  String              @unique @db.Char(64)
  expiresAt  DateTime            @db.Timestamptz(3)
  consumedAt DateTime?           @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)

  @@index([userId, provider, expiresAt])
}

model CalendarEventSync {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @db.Uuid
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationAccountId String             @db.Uuid
  integrationAccount   IntegrationAccount @relation(fields: [integrationAccountId], references: [id], onDelete: Cascade)
  routineBlockId       String             @unique @db.Uuid
  routineBlock         RoutineBlock       @relation(fields: [routineBlockId], references: [id], onDelete: Cascade)
  calendarId           String             @default("primary") @db.VarChar(255)
  externalEventId      String             @db.VarChar(1024)
  status               CalendarSyncStatus @default(SYNCED)
  payloadHash          String             @db.Char(64)
  htmlLink             String?            @db.Text
  lastError            String?            @db.Text
  lastSyncedAt         DateTime            @default(now()) @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([integrationAccountId, externalEventId])
  @@index([userId, status])
}

model TrainingCycle {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @db.Uuid
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String              @db.VarChar(160)
  startDate       DateTime            @db.Date
  endDate         DateTime            @db.Date
  status          TrainingCycleStatus @default(DRAFT)
  conclusion      CycleConclusion?
  conclusionNotes String?             @db.Text
  focuses         CycleFocus[]
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  @@index([userId, status])
  @@index([userId, startDate, endDate])
}

model CycleFocus {
  cycleId         String        @db.Uuid
  focusAreaId     String        @db.Uuid
  cycle           TrainingCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  focusArea       FocusArea     @relation(fields: [focusAreaId], references: [id], onDelete: Restrict)
  priority        FocusPriority
  successCriteria String        @db.Text
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@id([cycleId, focusAreaId])
  @@index([cycleId, priority])
}

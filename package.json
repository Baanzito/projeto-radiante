{
  "name": "projeto-radiante",
  "version": "0.3.0",
  "private": true,
  "description": "Aplicativo local-first de treino deliberado para VALORANT.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api run dev",
    "dev:web": "pnpm --filter web run dev",
    "dev:api": "pnpm --filter api run dev",
    "build": "pnpm --filter api run build && pnpm --filter web run build",
    "test": "pnpm --filter api run test && pnpm --filter web run test",
    "test:e2e": "pnpm --filter api run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter api run prisma:generate",
    "db:migrate": "pnpm --filter api run prisma:migrate",
    "db:seed": "pnpm --filter api run prisma:seed",
    "db:studio": "pnpm --filter api run prisma:studio",
    "check": "pnpm run format:check && pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}
